# Sway config — plain Sway + Dux Shell (DMS)
#
# Read `man 5 sway` for a complete reference.

### Session / startup
#
# Export the environment to systemd and start the session target that DMS is bound to
# (systemctl --user add-wants sway-session.target dms). Don't also `exec dms run`.
exec dbus-update-activation-environment --systemd --all
exec systemctl --user start sway-session.target

exec env RUST_BACKTRACE=1 RUST_LOG=swayr=debug swayrd > /tmp/swayrd.log 2>&1

# Polkit agent. If DMS shows its own authentication dialogs, remove this line.
exec sh -c 'for a in /usr/lib/polkit-kde-authentication-agent-1 /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done'

exec_always autotiling
# Removed: mako (DMS handles notifications) and swayidle (set idle/lock timeouts in
# DMS Settings → Power & battery).

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher (DMS Spotlight)
set $menu dms ipc call spotlight toggle

include /etc/sway/config-vars.d/*

### Output configuration
